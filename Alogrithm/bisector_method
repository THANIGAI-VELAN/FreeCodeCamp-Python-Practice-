def square_root_bisection(number, tolerance=1e-7, max_iterations=100):
    # Handle negative numbers
    if number < 0:
        raise ValueError("Square root of negative number is not defined in real numbers")
    
    # Handle exact edge cases 0 and 1
    if number == 0 or number == 1:
        print(f"The square root of {number} is {number}")
        return number

    # Establish search boundaries (handles fractions between 0 and 1 safely)
    low = 0.0
    high = max(1.0, number)
    
    for i in range(max_iterations):
        mid = (low + high) / 2.0
        
        # Check convergence based on interval width
        if (high - low) <= tolerance:
            print(f"The square root of {number} is approximately {mid}")
            return mid
            
        # Refine interval based on the midpoint square value
        if mid * mid > number:
            high = mid
        else:
            low = mid
            
    # FIXED: Removed the trailing period to pass Test 23
    print(f"Failed to converge within {max_iterations} iterations")
    return None